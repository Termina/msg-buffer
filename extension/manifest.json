{
  "manifest_version": 3,
  "name": "Msg Gemini",
  "version": "1.0",
  "description": "interact with Gemini",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Click to open panel"
  },
  "icons": {
    "128": "gemini-icon.png"
  },
  "side_panel": {
    "default_path": "dist/index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "Command+MacCtrl+G"
      }
    }
  },
  "permissions": ["sidePanel", "scripting", "activeTab", "contextMenus", "storage"]
}
